{
  "name": "matcha-flavoured-wiki",
  "version": "0.1.0",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-with-updates.mjs",
    "dev:plain": "vite --host 0.0.0.0 --port 3001 --strictPort",
    "update": "node scripts/update-matcha.mjs",
    "update:check": "node scripts/update-matcha.mjs --check",
    "build": "vite build",
    "build:pages": "BASE_PATH=/MatchaFlavouredWiki/ vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3001 --strictPort",
    "test": "npm run build:pages && node --test tests/rendered-html.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.8.0",
    "globals": "14.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.1.5"
  },
  "type": "module"
}
